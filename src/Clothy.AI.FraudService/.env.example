# Demo service settings. Copy to .env; variables set in the terminal take precedence over .env.
# Relative paths are resolved from the repository root. Invalid values stop startup with an explanation.

# Folder with the models, encoders.json, service_config.yaml and ring_signal.yaml
MODELS_DIR=models
# Model: main (34 features) or device (41 features, with the device fingerprint block)
MODEL_VARIANT=main
# Flagged share on validation used to pick the threshold: 0.005, 0.01, 0.02, 0.03 or 0.05
FLAG_RATE=0.01
# History store: memory (lost on restart) or sqlite (the DB_PATH file, required for /tx and /rings)
STORE_BACKEND=sqlite
# SQLite database file (the folder must exist) or :memory:; used only with STORE_BACKEND=sqlite
DB_PATH=history.db
# Ring signal with parameters from models/ring_signal.yaml: on/1/true/yes or off/0/false/no
RING_SIGNAL=on
# Service logging level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
