# Налаштування демо-сервісу. Скопіюйте у .env; змінні, задані в терміналі, мають пріоритет над .env.
# Відносні шляхи рахуються від кореня репозиторію. Неправильні значення зупиняють старт із поясненням.

# Тека з моделями, encoders.json, service_config.yaml і ring_signal.yaml
MODELS_DIR=models
# Модель: main (34 ознаки) або device (41 ознака, з блоком відбитка пристрою)
MODEL_VARIANT=main
# Частка позначених транзакцій на валідації, за якою взято поріг: 0.005, 0.01, 0.02, 0.03 або 0.05
FLAG_RATE=0.01
# Сховище історії: memory (зникає при перезапуску) або sqlite (файл DB_PATH, потрібне для /tx і /rings)
STORE_BACKEND=sqlite
# Файл бази SQLite (тека має існувати) або :memory:; використовується лише при STORE_BACKEND=sqlite
DB_PATH=history.db
# Сигнал кільця за параметрами з models/ring_signal.yaml: on/1/true/yes або off/0/false/no
RING_SIGNAL=on
# Рівень логування сервісу: DEBUG, INFO, WARNING або ERROR
LOG_LEVEL=INFO
